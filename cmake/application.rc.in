#include <windows.h>
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/cmake/disccenter.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/cmake/application.manifest"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@DISCCENTER_NAME@"
      VALUE "ProductName", "@DISCCENTER_NAME@"
      VALUE "FileVersion", "@DISCCENTER_VERSION@"
      VALUE "ProductVersion", "@DISCCENTER_VERSION@"
      VALUE "OriginalFilename", "DiscCenter.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
